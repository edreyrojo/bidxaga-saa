rules_version = '2';

// Incluye administración: usuarios, avisos, rankings, sugerencias, repaso y auditoría.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Un administrador puede serlo por custom claim (`admin: true`) o por el
    // campo `role` de su propio documento. El campo `role` queda protegido
    // abajo para que un usuario no pueda ascenderse a sí mismo.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role is string &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role.lower() == 'admin'
        )
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function esRegistroRepasoValido(data) {
      return data.tipo in ['fauna', 'flora']
        && data.id is int
        && data.palabra is string
        && data.palabra.size() <= 120
        && (!('spanish' in data) || (data.spanish is string && data.spanish.size() <= 120))
        && data.aciertos is int && data.aciertos >= 0 && data.aciertos <= 100000
        && data.errores is int && data.errores >= 0 && data.errores <= 100000
        && data.caja is int && data.caja >= 0 && data.caja <= 5
        && data.racha is int && data.racha >= 0 && data.racha <= 100000
        && data.ultimaVez is int && data.ultimaVez >= 0
        && data.proximoRepaso is int && data.proximoRepaso >= 0;
    }

    function usuarioActualizacionValida(data) {
      return (!('totopos' in data) || (data.totopos is number && data.totopos >= 0))
        && (!('totoposHistoricos' in data) || (
          data.totoposHistoricos is number && data.totoposHistoricos >= 0
        ))
        && (!('vidas' in data) || (
          data.vidas is map || (data.vidas is number && data.vidas >= 0)
        ))
        && (!('progreso' in data) || data.progreso is map)
        && (!('role' in data) || (
          data.role is string && data.role.lower() in ['', 'admin']
        ))
        && (!('logrosDesbloqueados' in data) || data.logrosDesbloqueados is list)
        && (!('retoDiario' in data) || (
          data.retoDiario is map
          && data.retoDiario.fecha is string
          && data.retoDiario.fecha.size() == 10
          && data.retoDiario.aciertos is int
          && data.retoDiario.aciertos >= 0
          && data.retoDiario.total is int
          && data.retoDiario.total > 0
          && data.retoDiario.recompensa is int
          && data.retoDiario.recompensa >= 0
          && data.retoDiario.completadoEn is int
        ))
        && (!('rachaReto' in data) || (
          data.rachaReto is map
          && data.rachaReto.dias is int
          && data.rachaReto.dias >= 0
          && data.rachaReto.ultimoDia is string
          && data.rachaReto.ultimoDia.size() == 10
        ));
    }

    match /usuarios/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && !('role' in request.resource.data)
        && request.resource.data.totopos is number
        && request.resource.data.totopos >= 0;

      allow update: if usuarioActualizacionValida(request.resource.data)
        && (
          (
            isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'createdAt'])
          )
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role', 'totopos', 'totoposHistoricos'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
              || request.auth.token.admin == true
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Historial de repaso espaciado: una subcolección por usuario.
    match /usuarios/{uid}/repaso/{clave} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && clave.size() <= 40
        && esRegistroRepasoValido(request.resource.data);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /avisos/{avisoId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 1
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 1
        && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() <= 40
        && (!('activo' in request.resource.data) || request.resource.data.activo is bool)
        && (!('prioridad' in request.resource.data) || request.resource.data.prioridad in ['normal', 'alta'])
        && (!('expiraEn' in request.resource.data) || request.resource.data.expiraEn == null || request.resource.data.expiraEn is int)
        && (!('publicadoEn' in request.resource.data) || request.resource.data.publicadoEn == null || request.resource.data.publicadoEn is int)
        && (!('actualizadoEn' in request.resource.data) || request.resource.data.actualizadoEn is int);
      allow delete: if isAdmin();
    }

    match /ranking/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.score is number
        && request.resource.data.score > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if (
        signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.score is number
        && request.resource.data.score > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
      );
      allow delete: if isAdmin() || (signedIn() && docId == request.auth.uid);
    }

    match /ranking_trivia/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.errores is number
        && request.resource.data.errores >= 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if (
        signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.errores is number
        && request.resource.data.errores >= 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
      );
      allow delete: if isAdmin() || (signedIn() && docId == request.auth.uid);
    }

    match /ranking_sopa/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.intentos is number
        && request.resource.data.intentos > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if (
        signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.intentos is number
        && request.resource.data.intentos > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
      );
      allow delete: if isAdmin() || (signedIn() && docId == request.auth.uid);
    }

    match /ranking_crucigrama/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.intentos is number
        && request.resource.data.intentos > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if (
        signedIn()
        && docId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.intentos is number
        && request.resource.data.intentos > 0
        && request.resource.data.completado == true
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
      );
      allow delete: if isAdmin() || (signedIn() && docId == request.auth.uid);
    }

    // Ranking diario del reto: una subcolección por fecha.
    match /ranking_reto/{fecha}/jugadores/{uid} {
      allow read: if true;
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.fecha == fecha
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.aciertos is int
        && request.resource.data.aciertos >= 0
        && request.resource.data.aciertos <= 5
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.racha is int
        && request.resource.data.racha >= 0
        && request.resource.data.completadoEn is int;
      allow update: if (
        signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.fecha == fecha
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.aciertos is int
        && request.resource.data.aciertos >= 0
        && request.resource.data.aciertos <= 5
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.racha is int
        && request.resource.data.racha >= 0
        && request.resource.data.completadoEn is int
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 60
      );
      allow delete: if isAdmin() || (signedIn() && uid == request.auth.uid);
    }

    // Sugerencias de hablantes: cualquiera puede enviar, solo el admin las revisa.
    match /sugerencias/{sugerenciaId} {
      allow create: if
        request.resource.data.tipo in ['palabra', 'correccion', 'audio', 'otro']
        && request.resource.data.palabra is string
        && request.resource.data.palabra.size() >= 2
        && request.resource.data.palabra.size() <= 120
        && request.resource.data.significado is string
        && request.resource.data.significado.size() >= 1
        && request.resource.data.significado.size() <= 240
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() <= 80
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 500
        && request.resource.data.contacto is string
        && request.resource.data.contacto.size() <= 120
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen == 'app'
        && request.resource.data.creadoEn is int
        && (
          request.auth == null
            ? request.resource.data.uid == null
            : request.resource.data.uid == request.auth.uid
        );

      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.estado in ['aprobada', 'rechazada', 'convertida']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'revisadoEn', 'revisadoPor', 'revisorNombre', 'notaAdmin', 'convertidoEn'
        ]);
      allow delete: if isAdmin();
    }

    // Auditoría administrativa: solo se agrega, nunca se edita ni se borra.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorNombre is string
        && request.resource.data.actorNombre.size() <= 80
        && request.resource.data.accion is string
        && request.resource.data.accion.size() <= 60
        && request.resource.data.objetivo is string
        && request.resource.data.objetivo.size() <= 200
        && request.resource.data.detalle is map
        && request.resource.data.creadoEn is int;
      allow update, delete: if false;
    }

    // Salas del duelo 1v1 de Memorama. El anfitrión crea la sala, el rival
    // se une con un código y solo el jugador en turno puede mover la mesa.
    match /salas/{codigo} {
      allow read: if signedIn() && (
        resource == null
        || resource.data.estado == 'esperando'
        || request.auth.uid in resource.data.jugadores
        || request.auth.uid == resource.data.anfitrion
      );

      allow create: if signedIn()
        && codigo.size() == 6
        && request.resource.data.codigo == codigo
        && request.resource.data.anfitrion == request.auth.uid
        && request.resource.data.estado == 'esperando'
        && request.resource.data.jugadores is map
        && request.resource.data.jugadores.keys().size() == 1
        && request.auth.uid in request.resource.data.jugadores
        && request.resource.data.jugadores[request.auth.uid].nombre is string
        && request.resource.data.jugadores[request.auth.uid].nombre.size() <= 40;

      allow update: if signedIn() && (
        // El rival se une mientras la sala está esperando.
        (
          resource.data.estado == 'esperando'
          && !(request.auth.uid in resource.data.jugadores)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'jugadores', 'actualizadoEn'
          ])
          && request.resource.data.jugadores.keys().size() == 2
          && request.auth.uid in request.resource.data.jugadores
          && request.resource.data.jugadores[request.auth.uid].nombre is string
          && request.resource.data.jugadores[request.auth.uid].nombre.size() <= 40
        )
        // El anfitrión inicia, reinicia o cierra la partida.
        || (
          request.auth.uid == resource.data.anfitrion
          && request.resource.data.jugadores.keys().size() == 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'mazo', 'volteadas', 'bloqueado', 'resuelto',
            'puntajes', 'turno', 'orden', 'ganador', 'iniciadoEn', 'actualizadoEn'
          ])
        )
        // Acciones del jugador en turno: voltear, resolver pareja o terminar.
        || (
          request.auth.uid in resource.data.jugadores
          && request.auth.uid == resource.data.turno
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mazo', 'volteadas', 'bloqueado', 'resuelto',
            'puntajes', 'turno', 'estado', 'ganador', 'actualizadoEn'
          ])
        )
        // Cerrar el turno tras un fallo: cualquiera de los dos participantes.
        || (
          request.auth.uid in resource.data.jugadores
          && resource.data.bloqueado == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'volteadas', 'bloqueado', 'resuelto', 'turno', 'actualizadoEn'
          ])
        )
        // Un participante puede salir y quitarse de la sala.
        || (
          request.auth.uid in resource.data.jugadores
          && !(request.auth.uid in request.resource.data.jugadores)
          && request.resource.data.jugadores.keys().size() == 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'jugadores', 'actualizadoEn'
          ])
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.anfitrion;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "memorama-diidxaza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run check:assets",
    "postbuild": "node scripts/generar-sw.mjs",
    "check:assets": "node scripts/verificar-assets.mjs",
    "optimizar:imagenes": "node scripts/optimizar-imagenes.mjs",
    "optimizar:audio": "node scripts/optimizar-audio.mjs",
    "optimizar": "npm run optimizar:imagenes && npm run optimizar:audio",
    "check:rules": "firebase deploy --only firestore:rules --dry-run",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:repaso": "node scripts/probar-repaso.mjs",
    "test:reto": "node scripts/probar-reto.mjs",
    "test:calidad": "node scripts/probar-calidad.mjs",
    "test:admin": "node scripts/probar-admin.mjs",
    "test": "npm run test:repaso && npm run test:reto && npm run test:calidad && npm run test:admin",
    "admin:claim": "node scripts/crear-admin.mjs",
    "ci": "npm run lint && npm test && npm run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "lucide-react": "^1.77.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1"
  }
}
